# Copy this file to .env for local Docker Compose runs.
# Do not commit real secret values.

POSTGRES_DB=delta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Use a long random value in real environments, for example from a secret manager.
JWT_SECRET=replace-this-with-a-long-random-production-secret-at-least-32-bytes

# Prometheus uses this token to scrape /actuator/prometheus.
# Keep this value in sync with monitoring/prometheus/prometheus-token.txt for local Compose.
PROMETHEUS_BEARER_TOKEN=replace-this-with-a-long-random-monitoring-token

# Grafana local admin credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# JVM options for the app container.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
