# Copy this file to .env for local Docker Compose runs.
# Do not commit real secret values.

POSTGRES_DB=delta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Use a long random value in real environments, for example from a secret manager.
JWT_SECRET=replace-this-with-a-long-random-production-secret-at-least-32-bytes

# Prometheus uses this token to scrape /metrics.
# Keep this value in sync with monitoring/prometheus/prometheus-token.txt for local Compose.
PROMETHEUS_BEARER_TOKEN=replace-this-with-a-long-random-monitoring-token

# Trust X-Forwarded-For/X-Real-IP for IP rate limiting. Keep true only when a
# trusted reverse proxy overwrites these headers; set false for direct exposure.
TRUST_PROXY_HEADERS=true

# Grafana local admin credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Service configuration (Go backend).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/delta
PORT=8080
AUTO_MIGRATE=true
LOG_LEVEL=info
LOG_FORMAT=text

# Token lifetimes in milliseconds (optional; defaults apply when unset).
JWT_ACCESS_TOKEN_TTL=900000
JWT_REFRESH_TOKEN_TTL=2592000000
JWT_REFRESH_CLEANUP_INTERVAL=86400000
JWT_REFRESH_REVOKED_RETENTION=604800000
