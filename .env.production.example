# Production environment template.
# Copy to .env on the server and fill in REAL secrets. Never commit this file.
#
#   cp .env.production.example .env
#   sed -i 's/CHANGE_ME_DB_PASSWORD/.../' .env   (or edit with nano)

# --- Postgres (docker-compose builds DATABASE_URL from these) ---
POSTGRES_DB=delta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- App secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
PROMETHEUS_BEARER_TOKEN=CHANGE_ME_PROMETHEUS_TOKEN

# --- App configuration ---
TRUST_PROXY_HEADERS=true
PORT=8080
AUTO_MIGRATE=true
LOG_LEVEL=info
LOG_FORMAT=json

# --- Token lifetimes in milliseconds (optional; defaults apply when unset) ---
JWT_ACCESS_TOKEN_TTL=900000
JWT_REFRESH_TOKEN_TTL=2592000000
JWT_REFRESH_CLEANUP_INTERVAL=86400000
JWT_REFRESH_REVOKED_RETENTION=604800000

# --- Grafana admin credentials (only if you run grafana from compose) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD